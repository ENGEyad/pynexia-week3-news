<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F4F5EE" android:padding="20dp">
 <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PYNEXIA / LIVE NEWS" android:textColor="#246A5B" android:textStyle="bold" android:textSize="12sp" android:letterSpacing="0.1" android:layout_marginTop="10dp"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="The world,
in the moment." android:textColor="#193F36" android:textSize="34sp" android:fontFamily="sans-serif-medium" android:layout_marginTop="12dp"/>
 <TextView android:id="@+id/intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fresh reporting from around the world." android:textColor="#5C7067" android:textSize="14sp" android:layout_marginTop="6dp" android:layout_marginBottom="12dp"/>
 <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"><LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
 <Button android:id="@+id/tech" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Technology" android:textAllCaps="false" android:backgroundTint="#246A5B" android:textColor="#FFFFFF"/>
 <Button android:id="@+id/business" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Business" android:textAllCaps="false" android:layout_marginStart="8dp" android:backgroundTint="#DCE7DA" android:textColor="#193F36"/>
 <Button android:id="@+id/sports" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Sports" android:textAllCaps="false" android:layout_marginStart="8dp" android:backgroundTint="#DCE7DA" android:textColor="#193F36"/>
 </LinearLayout></HorizontalScrollView>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Loading headlines…" android:textColor="#5C7067" android:textSize="13sp" android:paddingTop="8dp" android:paddingBottom="8dp"/>
 <Button android:id="@+id/retry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Try again" android:textAllCaps="false" android:visibility="gone"/>
 <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><androidx.recyclerview.widget.RecyclerView android:id="@+id/articleList" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="12dp"/></androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
