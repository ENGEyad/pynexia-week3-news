<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/card" android:padding="12dp" android:layout_marginBottom="12dp">
 <ImageView android:id="@+id/articleImage" android:layout_width="match_parent" android:layout_height="168dp" android:scaleType="centerCrop" android:contentDescription="News article image"/>
 <TextView android:id="@+id/articleMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#557066" android:textSize="12sp" android:layout_marginTop="10dp"/>
 <TextView android:id="@+id/articleTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#193F36" android:textSize="19sp" android:textStyle="bold" android:layout_marginTop="5dp"/>
</LinearLayout>
